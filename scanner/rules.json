    "connections.json",
    "secure-token-storage.json",
    "auth.json",
    "mcp.json",
    "mcp_config.json",
    "claude_desktop_config.json",
    "workflow*.json",
    "*workflow*.json",
    "settings.json",
    "preferences",
    "config.toml",
    "config.yaml",
    "config.yml",
    "config.json"
