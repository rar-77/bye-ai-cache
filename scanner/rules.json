{
  "version": "1.5.0",
  "safety_levels": {
    "green": {
      "label": "CACHE PURA / 100% SEGURO",
      "description": "Cachés técnicas de agentes (Hermes, Antigravity, Codex, Cursor, Claude), paquetes pip/npm/conda, temporales, logs y caché de Adobe. Jamás borra skills, memorias, chats, workflows ni modelos."
    },
    "yellow": {
      "label": "MODELOS / OUTPUTS / SHADERS / HISTORIALES",
      "description": "Pesos de modelos (.safetensors, .gguf), renders de ComfyUI, historiales de sesiones/chats pasados y shaders DirectX de NVIDIA (DXCache). Revisar antes de borrar."
    },
    "red": {
      "label": "PROTEGIDO / SKILLS, MEMORIA & CONFIG",
      "description": "Skills, comandos y memorias de Hermes, Codex, Claude, Cursor y Antigravity (.hermes.md, CLAUDE.md, AGENTS.md, .cursorrules), workflows .json de ComfyUI y configs MCP. Bloqueados con candado."
    }
  },
  "protected_patterns": [
    ".hermes.md",
    "skill.md",
    "claude.md",
    "gemini.md",
    "agents.md",
    "instructions.md",
    ".cursorrules",
    "*.mdc",
    ".windsurfrules",
    ".clinerules",
    ".aider.conf.yml",
    "hermes_memory*",
    "*memory*",
    "*skill*",
